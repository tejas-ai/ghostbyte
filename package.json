{
  "name": "quietsend-steganography-system",
  "description": "QuietSend — Advanced client-side steganography suite with authenticated AES-GCM-256 (600k PBKDF2 iterations) & Zero-Server-Retention.",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "node scripts/verify-build.js",
    "build:verify": "npm run build && npm run verify"
  },
  "dependencies": {
    "@types/utif": "^3.0.6",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "happy-dom": "^20.11.6",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^3.0.8"
  }
}
